# API environment variables (for containerized / production deployments).
#
# These are read via getenv() at runtime. For local development you can instead
# keep using config/oci_config.php (gitignored) — the app falls back to it when
# the DB_* variables are not set. PHP does not auto-load this file; the runtime
# (Docker, the shell, or a process manager) must export the variables.

# Oracle database credentials.
DB_USERNAME=CLIENT
DB_PASSWORD=change-me
# Full Oracle connect descriptor or TNS alias.
DB_TNS_NAME=your_db_high

# Wallet directory (so pdo_oci can find cwallet.sso / sqlnet.ora).
TNS_ADMIN=/opt/oracle/wallet

# Comma-separated list of allowed CORS origins (the front-end origins).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
