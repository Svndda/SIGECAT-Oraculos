# Web client environment (Vite). Copy to .env.local and adjust as needed.
# Vite only exposes variables prefixed with VITE_, and they are inlined at build
# time — so set this before `npm run build` for a deployed front-end.

# Base URL of the API, including the /api/public prefix.
VITE_API_BASE_URL=http://localhost:8000/api/public
